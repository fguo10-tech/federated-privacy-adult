# Data: never commit downloaded or generated datasets.
# Generators, download scripts, checksums and tiny test fixtures are committed instead.
data/cache/
data/adult/
data/femnist/
data/synthetic/*.csv
data/synthetic/*.npz
!data/synthetic/samples/

# Experiment outputs: only the reference run behind the [Reproduced] numbers is committed.
experiments/results/runs/
notebooks/_executed/
*.pt
*.ckpt

# Secrets
.env
*.pem
*.key
